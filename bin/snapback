#!/usr/bin/env python3
"""snapback CLI: `snapback [list] | show [ID] | restore [ID] [PATH...] | clear  [--project DIR]`.

Lists the snapshots taken in this repository, shows what one would change, and restores it.
`clear` deletes every snapshot of the repository.
ID defaults to the latest snapshot.
"""
import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import hookio  # noqa: E402
from snapback.core import (DEFAULTS, PLUGIN, clear, describe, differences, find, gitlinks, here, load,  # noqa: E402
                             repo_root, restore)


def main() -> int:
    ap = argparse.ArgumentParser(prog="snapback")
    ap.add_argument("action", nargs="?", default="list", choices=["list", "show", "restore", "clear"])
    ap.add_argument("id", nargs="?", default="last", help="snapshot id (default: the latest)")
    ap.add_argument("paths", nargs="*", help="with restore: only these files or directories")
    ap.add_argument("--project", default=os.getcwd())
    a = ap.parse_args()
    cwd = Path(a.project)
    root = repo_root(cwd)
    if not root:
        print(f"{os.path.abspath(a.project)} is not inside a git repository; snapback only works in one")
        return 1
    cfg = hookio.load_config(PLUGIN, root, DEFAULTS)
    if a.action == "list":
        rows = load(root)
        mine = here(root, rows)
        if not mine:
            print("no snapshots for this working tree yet")
        for r in reversed(mine):
            print(describe(r))
        for other in sorted({r.get("root") for r in rows if r not in mine}):
            print(f"more in another working tree of this repository: snapback list --project {other}")
        return 0
    if a.action == "clear":
        print(f"deleted {clear(root)} snapshot(s); `git gc --prune=now` frees the space they used")
        return 0
    try:
        row = find(root, a.id)
        if a.action == "show":
            print(describe(row).strip())
            if row.get("kind") == "stash":
                print(f"  a discarded stash entry: {row.get('subject', '')}")
                return 0
            changes = differences(root, row, cfg)
            if not changes:
                print("  nothing to restore: every file in the snapshot matches the working tree")
            for status, path in changes:
                print(f"  {'missing now, would come back' if status == 'A' else 'differs now, would be reverted'}: {path}")
            for path in sorted(gitlinks(root, row["tree"])):
                print(f"  not in the snapshot (nested repository or submodule): {path}")
            return 0
        for line in restore(root, row, cfg, a.paths, cwd):
            print(line)
        return 0
    except (LookupError, RuntimeError) as e:
        print(f"snapback: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
